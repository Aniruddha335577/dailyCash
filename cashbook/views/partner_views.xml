<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashbook_partner_list" model="ir.ui.view">
        <field name="name">cashbook.partner.list</field>
        <field name="model">cashbook.partner</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_type"/>
                <field name="phone"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cashbook_partner_form" model="ir.ui.view">
        <field name="name">cashbook.partner.form</field>
        <field name="model">cashbook.partner</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="partner_type"/>
                        <field name="phone"/>
                        <field name="notes"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cashbook_partner_search" model="ir.ui.view">
        <field name="name">cashbook.partner.search</field>
        <field name="model">cashbook.partner</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="phone"/>
                <filter name="customer" string="Customers" domain="[('partner_type', 'in', ['customer', 'both'])]"/>
                <filter name="vendor" string="Vendors" domain="[('partner_type', 'in', ['vendor', 'both'])]"/>
                <group>
                    <filter name="group_type" string="Type" context="{'group_by': 'partner_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_cashbook_partner" model="ir.actions.act_window">
        <field name="name">Partners</field>
        <field name="res_model">cashbook.partner</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
