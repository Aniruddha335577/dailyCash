<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashbook_business_list" model="ir.ui.view">
        <field name="name">cashbook.business.list</field>
        <field name="model">cashbook.business</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="currency_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cashbook_business_form" model="ir.ui.view">
        <field name="name">cashbook.business.form</field>
        <field name="model">cashbook.business</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="currency_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cashbook_business_search" model="ir.ui.view">
        <field name="name">cashbook.business.search</field>
        <field name="model">cashbook.business</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_cashbook_business" model="ir.actions.act_window">
        <field name="name">Businesses</field>
        <field name="res_model">cashbook.business</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
