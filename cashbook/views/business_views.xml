<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashbook_business_list" model="ir.ui.view">
        <field name="name">cashbook.business.list</field>
        <field name="model">cashbook.business</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="phone_1" optional="show"/>
                <field name="email" optional="show"/>
                <field name="city" optional="hide"/>
                <field name="country_id" optional="hide"/>
                <field name="currency_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cashbook_business_form" model="ir.ui.view">
        <field name="name">cashbook.business.form</field>
        <field name="model">cashbook.business</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar" options="{'preview_image': 'logo'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Business Name"/>
                        </h1>
                        <field name="legal_name" placeholder="Legal name (optional)"/>
                    </div>
                    <group>
                        <group string="Contact">
                            <field name="phone_1" widget="phone"/>
                            <field name="phone_2" widget="phone"/>
                            <field name="email" widget="email"/>
                            <field name="website" widget="url" placeholder="https://"/>
                        </group>
                        <group string="Address">
                            <field name="address_line_1" placeholder="Street, building, area"/>
                            <field name="address_line_2" placeholder="Suite, floor, landmark"/>
                            <field name="city"/>
                            <field name="state_id" domain="[('country_id', '=', country_id)]"/>
                            <field name="zip"/>
                            <field name="country_id"/>
                        </group>
                    </group>
                    <group string="Legal &amp; Tax">
                        <group>
                            <field name="tax_id"/>
                            <field name="registration_number"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Invoice Defaults">
                        <field name="invoice_footer" placeholder="Payment terms, bank details, or thank-you message for printed invoices."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cashbook_business_search" model="ir.ui.view">
        <field name="name">cashbook.business.search</field>
        <field name="model">cashbook.business</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="legal_name"/>
                <field name="phone_1"/>
                <field name="phone_2"/>
                <field name="email"/>
                <field name="city"/>
                <field name="tax_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_cashbook_business" model="ir.actions.act_window">
        <field name="name">Businesses</field>
        <field name="res_model">cashbook.business</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
