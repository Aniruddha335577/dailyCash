<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashbook_entry_type_list" model="ir.ui.view">
        <field name="name">cashbook.entry.type.list</field>
        <field name="model">cashbook.entry.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cashbook_entry_type_form" model="ir.ui.view">
        <field name="name">cashbook.entry.type.form</field>
        <field name="model">cashbook.entry.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cashbook_entry_type" model="ir.actions.act_window">
        <field name="name">Entry Types</field>
        <field name="res_model">cashbook.entry.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
