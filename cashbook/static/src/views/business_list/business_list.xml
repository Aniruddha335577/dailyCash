<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cashbook.BusinessList">
        <div class="o_action o_cashbook_card_list">
            <Layout display="display">
                <t t-set-slot="layout-buttons">
                    <div class="o_cp_buttons d-flex gap-2">
                        <button type="button" class="btn btn-primary" t-on-click="createBusiness">
                            <i class="fa fa-plus me-1"/> New Business
                        </button>
                        <button type="button" class="btn btn-secondary" t-on-click="openClassicList">
                            Classic View
                        </button>
                    </div>
                </t>

                <div class="cb-card-page">
                    <div class="cb-card-toolbar">
                        <div class="cb-card-search">
                            <label class="cb-card-filter-label">Search</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-search"/></span>
                                <input type="text" class="form-control" placeholder="Business or currency..."
                                       t-model="state.search"/>
                            </div>
                        </div>
                    </div>

                    <t t-if="state.loading">
                        <div class="cb-empty-state">
                            <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                            <p class="mt-2 text-muted">Loading businesses...</p>
                        </div>
                    </t>
                    <t t-elif="!filteredBusinesses.length">
                        <div class="cb-empty-state">
                            <i class="fa fa-building fa-3x text-muted"/>
                            <h5 class="mt-3">No businesses found</h5>
                            <p class="text-muted">Create a business to organize your books and entries.</p>
                            <button type="button" class="btn btn-primary mt-2" t-on-click="createBusiness">
                                <i class="fa fa-plus me-1"/> New Business
                            </button>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="cb-card-grid">
                            <t t-foreach="filteredBusinesses" t-as="business" t-key="business.id">
                                <div class="cb-entity-card" t-on-click="() => this.openBusiness(business)">
                                    <div class="cb-entity-card-head">
                                        <div class="cb-entity-icon cb-entity-icon-business">
                                            <i class="fa fa-building"/>
                                        </div>
                                        <div class="flex-grow-1 min-w-0">
                                            <h3 class="cb-entity-title text-truncate" t-esc="business.name"/>
                                            <div class="cb-entity-subtitle text-truncate"
                                                 t-esc="business.currency_id ? business.currency_id[1] : ''"/>
                                        </div>
                                    </div>
                                    <div class="cb-entity-meta">
                                        <span class="cb-meta-pill">
                                            <i class="fa fa-book me-1"/>
                                            <t t-esc="bookCount(business)"/> books
                                        </span>
                                    </div>
                                    <t t-set="stats" t-value="businessStats(business)"/>
                                    <div class="cb-entity-stats">
                                        <div class="cb-entity-stat">
                                            <span class="cb-entity-stat-label">Entries</span>
                                            <span class="cb-entity-stat-value" t-esc="stats.count"/>
                                        </div>
                                        <div class="cb-entity-stat">
                                            <span class="cb-entity-stat-label">Total</span>
                                            <span class="cb-entity-stat-value"
                                                  t-esc="formatMoney(stats.total, business.currency_id[0])"/>
                                        </div>
                                        <div class="cb-entity-stat">
                                            <span class="cb-entity-stat-label">Due</span>
                                            <span class="cb-entity-stat-value cb-stat-due"
                                                  t-esc="formatMoney(stats.due, business.currency_id[0])"/>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                </div>
            </Layout>
        </div>
    </t>

</templates>
