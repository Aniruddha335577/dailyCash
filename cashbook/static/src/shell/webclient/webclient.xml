<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cashbook.WebClient">
        <t t-if="!state.fullscreen">
            <NavBar/>
        </t>
        <!-- Keep a single ActionContainer so restored actions survive shell init on refresh. -->
        <div t-att-class="{ cb_shell_layout: useCashbookShell }">
            <CashbookSidebar t-if="useCashbookShell and !env.isSmall"/>
            <main t-att-class="{ cb_shell_main: useCashbookShell }">
                <ActionContainer/>
            </main>
        </div>
        <MainComponentsContainer/>
    </t>

</templates>
