<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cashbook_entry" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="model">cashbook.entry</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cashbook.report_entry</field>
        <field name="report_file">cashbook.report_entry</field>
        <field name="print_report_name">'Cashbook-%s' % (object.name.replace('/', '-'))</field>
        <field name="binding_model_id" ref="model_cashbook_entry"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_entry_styles">
        <style type="text/css">
            @page {
                size: <t t-esc="template.page_size.upper()"/>;
                margin-top: <t t-esc="template.margin_top"/>mm;
                margin-bottom: <t t-esc="template.margin_bottom + 8"/>mm;
                margin-left: <t t-esc="template.margin_left"/>mm;
                margin-right: <t t-esc="template.margin_right"/>mm;
            }
            .cb-report {
                color: #1f2937;
                font-family: Helvetica, Arial, sans-serif;
                font-size: 11px;
                line-height: 1.45;
            }
            .cb-header-table { width: 100%; border-collapse: collapse; margin-bottom: 10px; }
            .cb-header-saas { width: 38%; vertical-align: top; }
            .cb-header-business { width: 62%; vertical-align: top; text-align: right; }
            .cb-saas-logo { max-height: 36px; max-width: 110px; object-fit: contain; }
            .cb-saas-label { font-size: 9px; color: #94a3b8; margin-top: 4px; letter-spacing: 0.04em; text-transform: uppercase; }
            .cb-business-logo { max-height: 52px; max-width: 120px; object-fit: contain; margin-left: auto; display: block; }
            .cb-business-name { font-size: 15px; font-weight: 700; color: <t t-esc="template.primary_color"/>; margin-top: 4px; }
            .cb-business-line { font-size: 10px; color: #64748b; margin-top: 2px; }
            .cb-header-separator { border-top: 1px solid #e2e8f0; margin: 12px 0 18px; }
            .cb-doc-title { font-size: 20px; font-weight: 700; letter-spacing: 0.06em; color: <t t-esc="template.primary_color"/>; margin: 0 0 4px; text-transform: uppercase; }
            .cb-doc-number { font-size: 13px; font-weight: 600; color: #334155; margin-bottom: 16px; }
            .cb-header-text { font-size: 11px; color: #64748b; margin-bottom: 14px; }
            .cb-info-table { width: 100%; border-collapse: collapse; margin-bottom: 18px; }
            .cb-info-col { width: 50%; vertical-align: top; padding-right: 12px; }
            .cb-info-col-right { padding-right: 0; padding-left: 12px; }
            .cb-section-title { font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: <t t-esc="template.primary_color"/>; border-bottom: 2px solid #e2e8f0; padding-bottom: 4px; margin-bottom: 8px; }
            .cb-field-table { width: 100%; border-collapse: collapse; }
            .cb-field-table td { padding: 3px 0; vertical-align: top; }
            .cb-field-label { width: 38%; font-size: 9px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.04em; }
            .cb-field-value { font-size: 11px; font-weight: 600; color: #1e293b; }
            .cb-lines-table { width: 100%; border-collapse: collapse; margin: 6px 0 14px; }
            .cb-lines-table thead { display: table-header-group; }
            .cb-lines-table th {
                background: #f8fafc;
                border-bottom: 2px solid <t t-esc="template.primary_color"/>;
                color: #475569;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 0.06em;
                padding: 8px 8px;
                text-align: left;
                text-transform: uppercase;
            }
            .cb-lines-table th.cb-num { text-align: right; }
            .cb-lines-table td { border-bottom: 1px solid #e2e8f0; padding: 8px 8px; vertical-align: top; }
            .cb-lines-table td.cb-num { text-align: right; white-space: nowrap; }
            .cb-line-desc { color: #64748b; font-size: 9px; margin-top: 2px; }
            .cb-amounts-wrap { width: 100%; margin-top: 4px; }
            .cb-amounts-table { width: 240px; margin-left: auto; border-collapse: collapse; }
            .cb-amounts-table td { padding: 5px 0; border-bottom: 1px solid #e2e8f0; }
            .cb-amount-label { font-size: 10px; color: #64748b; text-transform: uppercase; letter-spacing: 0.04em; }
            .cb-amount-value { text-align: right; font-size: 12px; font-weight: 700; color: #1e293b; }
            .cb-amount-due .cb-amount-value { color: <t t-esc="template.primary_color"/>; }
            .cb-notes { margin-top: 16px; padding: 10px 12px; background: #f8fafc; border-left: 3px solid <t t-esc="template.primary_color"/>; }
            .cb-notes-title { font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #64748b; margin-bottom: 4px; }
            .cb-notes-body { font-size: 11px; color: #334155; white-space: pre-wrap; }
            .cb-footer {
                margin-top: 22px;
                padding-top: 10px;
                border-top: 1px solid #e2e8f0;
                font-size: 9px;
                color: #94a3b8;
                text-align: center;
            }
            .cb-footer-line { margin-top: 3px; }
            .cb-footer-powered { margin-top: 6px; font-size: 8px; color: #cbd5e1; }
            .cb-layout-modern .cb-doc-title { border-bottom: 3px solid <t t-esc="template.primary_color"/>; padding-bottom: 6px; }
            .cb-layout-simple .cb-saas-logo { max-height: 30px; }
        </style>
    </template>

    <template id="report_entry_header">
        <t t-set="business" t-value="doc.get_report_business()"/>
        <table class="cb-header-table">
            <tr>
                <td class="cb-header-saas">
                    <t t-if="template.show_saas_logo and saas_logo_data_uri">
                        <img class="cb-saas-logo" t-att-src="saas_logo_data_uri" t-att-alt="saas_product_label"/>
                        <div class="cb-saas-label" t-esc="saas_product_label"/>
                    </t>
                </td>
                <td class="cb-header-business">
                    <t t-if="template.show_logo and business.logo">
                        <img class="cb-business-logo" t-att-src="image_data_uri(business.logo)" alt="Business Logo"/>
                    </t>
                    <t t-if="template.show_company_name and business.name">
                        <div class="cb-business-name" t-esc="business.name"/>
                    </t>
                    <t t-if="template.show_legal_name and business.legal_name">
                        <div class="cb-business-line" t-esc="business.legal_name"/>
                    </t>
                    <t t-if="template.show_address">
                        <t t-foreach="business._get_report_address_lines()" t-as="line">
                            <div class="cb-business-line" t-esc="line"/>
                        </t>
                    </t>
                    <t t-if="template.show_phone">
                        <t t-if="business.phone_1">
                            <div class="cb-business-line" t-esc="business.phone_1"/>
                        </t>
                        <t t-if="business.phone_2">
                            <div class="cb-business-line" t-esc="business.phone_2"/>
                        </t>
                    </t>
                    <t t-if="template.show_email and business.email">
                        <div class="cb-business-line" t-esc="business.email"/>
                    </t>
                </td>
            </tr>
        </table>
        <div class="cb-header-separator"/>
    </template>

    <template id="report_entry_info">
        <table class="cb-info-table">
            <tr>
                <td class="cb-info-col">
                    <div class="cb-section-title">Entry Details</div>
                    <table class="cb-field-table">
                        <t t-if="template.show_invoice_number or template.show_reference">
                            <tr>
                                <td class="cb-field-label">Entry No.</td>
                                <td class="cb-field-value" t-esc="doc.name"/>
                            </tr>
                        </t>
                        <t t-if="template.show_entry_number">
                            <tr>
                                <td class="cb-field-label">ID</td>
                                <td class="cb-field-value" t-esc="doc.id"/>
                            </tr>
                        </t>
                        <t t-if="template.show_date">
                            <tr>
                                <td class="cb-field-label">Date</td>
                                <td class="cb-field-value">
                                    <span t-field="doc.entry_datetime" t-options='{"widget": "datetime"}'/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="template.show_partner">
                            <tr>
                                <td class="cb-field-label">Partner</td>
                                <td class="cb-field-value" t-esc="doc.partner_id.name or '—'"/>
                            </tr>
                        </t>
                        <t t-if="template.show_book">
                            <tr>
                                <td class="cb-field-label">Book</td>
                                <td class="cb-field-value" t-esc="doc.book_id.name"/>
                            </tr>
                        </t>
                        <t t-if="template.show_reference and not template.show_invoice_number">
                            <tr>
                                <td class="cb-field-label">Reference</td>
                                <td class="cb-field-value" t-esc="doc.name"/>
                            </tr>
                        </t>
                    </table>
                </td>
                <td class="cb-info-col cb-info-col-right">
                    <div class="cb-section-title">Transaction</div>
                    <table class="cb-field-table">
                        <t t-if="template.show_money_direction">
                            <tr>
                                <td class="cb-field-label">Direction</td>
                                <td class="cb-field-value" t-esc="doc.get_report_direction_label()"/>
                            </tr>
                        </t>
                        <t t-if="template.show_payment_method">
                            <tr>
                                <td class="cb-field-label">Payment Method</td>
                                <td class="cb-field-value" t-esc="doc.get_payment_method_labels() or '—'"/>
                            </tr>
                        </t>
                        <t t-if="template.show_entry_type">
                            <tr>
                                <td class="cb-field-label">Entry Type</td>
                                <td class="cb-field-value" t-esc="doc.entry_type_id.name"/>
                            </tr>
                        </t>
                    </table>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_entry_lines">
        <t t-if="template.show_line_items and doc.line_ids">
            <table class="cb-lines-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th class="cb-num">Qty</th>
                        <th class="cb-num">Unit Price</th>
                        <th class="cb-num">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="doc.line_ids" t-as="line">
                        <td>
                            <div t-esc="line.product_name"/>
                            <t t-if="line.description">
                                <div class="cb-line-desc" t-esc="line.description"/>
                            </t>
                        </td>
                        <td class="cb-num">
                            <span t-esc="line.quantity"/>
                            <t t-if="line.uom"> <span t-esc="line.uom"/></t>
                        </td>
                        <td class="cb-num">
                            <span t-esc="doc.format_report_amount(line.product_price)"/>
                        </td>
                        <td class="cb-num">
                            <span t-esc="doc.format_report_amount(line.total_price)"/>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>

    <template id="report_entry_amounts">
        <t t-if="template.show_amount or template.show_paid or template.show_due">
            <div class="cb-amounts-wrap">
                <table class="cb-amounts-table">
                    <t t-if="template.show_amount">
                        <tr>
                            <td class="cb-amount-label">Total</td>
                            <td class="cb-amount-value" t-esc="doc.format_report_amount(doc.total_amount)"/>
                        </tr>
                    </t>
                    <t t-if="template.show_paid">
                        <tr>
                            <td class="cb-amount-label">Paid</td>
                            <td class="cb-amount-value" t-esc="doc.format_report_amount(doc.paid)"/>
                        </tr>
                    </t>
                    <t t-if="template.show_due">
                        <tr class="cb-amount-due">
                            <td class="cb-amount-label">Due</td>
                            <td class="cb-amount-value" t-esc="doc.format_report_amount(doc.due)"/>
                        </tr>
                    </t>
                </table>
            </div>
        </t>
    </template>

    <template id="report_entry_notes">
        <t t-if="template.show_description and doc.remarks">
            <div class="cb-notes">
                <div class="cb-notes-title">Notes / Remarks</div>
                <div class="cb-notes-body" t-esc="doc.remarks"/>
            </div>
        </t>
    </template>

    <template id="report_entry_footer">
        <t t-set="business" t-value="doc.get_report_business()"/>
        <t t-set="footer_text" t-value="doc.get_report_footer_text(template)"/>
        <div t-attf-class="cb-footer cb-align-#{template.footer_alignment}">
            <t t-if="template.show_footer_contact">
                <t t-if="template.show_address">
                    <t t-foreach="business._get_report_address_lines()" t-as="line">
                        <div class="cb-footer-line" t-esc="line"/>
                    </t>
                </t>
                <t t-foreach="business.get_report_contact_parts()" t-as="contact">
                    <div class="cb-footer-line" t-esc="contact"/>
                </t>
            </t>
            <t t-if="footer_text">
                <div class="cb-footer-line" t-esc="footer_text"/>
            </t>
            <t t-if="template.show_page_number">
                <div class="cb-footer-line">Page <span class="page"/> / <span class="topage"/></div>
            </t>
            <t t-if="template.show_powered_by">
                <div class="cb-footer-powered" t-esc="powered_by_label"/>
            </t>
        </div>
    </template>

    <template id="report_entry_document">
        <t t-set="template" t-value="doc.get_effective_report_template()"/>
        <t t-if="not template">
            <div class="cb-report-error">No report template configured.</div>
        </t>
        <t t-else="">
            <div t-attf-class="cb-report cb-layout-#{template.layout}">
                <t t-call="cashbook.report_entry_styles"/>

                <t t-call="cashbook.report_entry_header"/>

                <t t-if="template.header_text">
                    <div t-attf-class="cb-header-text cb-align-#{template.header_alignment}" t-esc="template.header_text"/>
                </t>

                <h1 class="cb-doc-title">Cashbook Entry</h1>
                <div class="cb-doc-number" t-esc="doc.name"/>

                <t t-call="cashbook.report_entry_info"/>
                <t t-call="cashbook.report_entry_lines"/>
                <t t-call="cashbook.report_entry_amounts"/>
                <t t-call="cashbook.report_entry_notes"/>
                <t t-call="cashbook.report_entry_footer"/>
            </div>
        </t>
    </template>

    <template id="report_entry">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <t t-call="cashbook.report_entry_document"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
