<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cashbook_entry_list" model="ir.actions.report">
        <field name="name">Entry List Report</field>
        <field name="model">cashbook.entry</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cashbook.report_entry_list</field>
        <field name="report_file">cashbook.report_entry_list</field>
        <field name="print_report_name">'Cashbook-Entry-Report'</field>
    </record>

    <template id="report_entry_list">
        <t t-call="web.html_container">
            <t t-call="cashbook.report_entry_list_document"/>
        </t>
    </template>

    <template id="report_entry_list_document">
        <t t-set="company" t-value="report_business"/>
        <style type="text/css">
            @page {
                size: A4 landscape;
                margin: 12mm 10mm 14mm 10mm;
            }
            .el-report {
                color: #26313F;
                font-family: Helvetica, Arial, sans-serif;
                font-size: 9px;
                line-height: 1.35;
            }
            .el-header {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            .el-header td { vertical-align: top; padding: 0; }
            .el-title {
                font-size: 18px;
                font-weight: 800;
                color: #1B2A41;
                letter-spacing: 0.03em;
            }
            .el-subtitle {
                font-size: 10px;
                color: #6B7684;
                margin-top: 2px;
            }
            .el-meta-right { text-align: right; font-size: 9px; color: #6B7684; }
            .el-filters {
                border: 1px solid #E4E6EA;
                background: #F4F5F7;
                padding: 8px 10px;
                margin-bottom: 10px;
            }
            .el-filters-title {
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 0.06em;
                color: #1B2A41;
                margin-bottom: 6px;
            }
            .el-filter-grid {
                width: 100%;
                border-collapse: collapse;
            }
            .el-filter-grid td {
                padding: 2px 8px 2px 0;
                vertical-align: top;
                width: 33%;
            }
            .el-filter-k { color: #6B7684; }
            .el-filter-v { font-weight: 600; color: #26313F; }
            .el-table {
                width: 100%;
                border-collapse: collapse;
                border-top: 2px solid #1B2A41;
            }
            .el-table thead { display: table-header-group; }
            .el-table th {
                background: #F5A623;
                color: #fff;
                font-weight: 600;
                font-size: 8px;
                text-align: left;
                padding: 7px 5px;
                letter-spacing: 0.04em;
            }
            .el-table th.el-num { text-align: right; }
            .el-table th.el-navy { background: #1B2A41; }
            .el-table td {
                padding: 6px 5px;
                border-bottom: 1px solid #E4E6EA;
                vertical-align: top;
                font-size: 8.5px;
            }
            .el-table tr.el-alt { background: #F4F5F7; }
            .el-table td.el-num { text-align: right; white-space: nowrap; }
            .el-dir-in { color: #059669; font-weight: 600; }
            .el-dir-out { color: #dc2626; font-weight: 600; }
            .el-remarks { color: #6B7684; font-size: 7.5px; margin-top: 2px; }
            .el-totals-wrap { margin-top: 10px; width: 100%; }
            .el-totals {
                width: 320px;
                margin-left: auto;
                border-collapse: collapse;
            }
            .el-totals td {
                padding: 5px 6px;
                font-size: 9px;
                border-top: 1px solid #E4E6EA;
            }
            .el-totals .el-k { color: #6B7684; }
            .el-totals .el-v { text-align: right; font-weight: 700; }
            .el-totals .el-grand td {
                background: #1B2A41;
                color: #fff;
                font-weight: 700;
            }
            .el-foot {
                margin-top: 10px;
                padding-top: 6px;
                border-top: 1px solid #E4E6EA;
                font-size: 8px;
                color: #6B7684;
                text-align: center;
            }
        </style>

        <div class="page el-report">
            <table class="el-header">
                <tr>
                    <td>
                        <div class="el-title">CASHBOOK ENTRY REPORT</div>
                        <t t-if="company">
                            <div class="el-subtitle" t-esc="company.name"/>
                        </t>
                        <div class="el-subtitle">
                            <span t-esc="len(docs)"/> selected entries
                        </div>
                    </td>
                    <td class="el-meta-right">
                        Generated on
                        <span t-esc="report_generated_at_label"/>
                        <t t-if="report_business and report_business.email">
                            <br/>
                            <span t-esc="report_business.email"/>
                        </t>
                    </td>
                </tr>
            </table>

            <t t-if="filter_lines">
                <div class="el-filters">
                    <div class="el-filters-title">APPLIED FILTERS</div>
                    <table class="el-filter-grid">
                        <tr t-foreach="filter_lines" t-as="line">
                            <td colspan="3">
                                <span class="el-filter-k" t-esc="line.get('label')"/>:
                                <span class="el-filter-v" t-esc="line.get('value')"/>
                            </td>
                        </tr>
                    </table>
                </div>
            </t>

            <table class="el-table">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th class="el-navy">Date / Time</th>
                        <th class="el-navy">Direction</th>
                        <th class="el-navy">Business</th>
                        <th class="el-navy">Book</th>
                        <th class="el-navy">Type</th>
                        <th class="el-navy">Partner</th>
                        <th class="el-navy">Payment</th>
                        <th class="el-num el-navy">Total</th>
                        <th class="el-num el-navy">Settled</th>
                        <th class="el-num el-navy">Outstanding</th>
                        <th class="el-navy">Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="docs" t-as="doc" t-att-class="'el-alt' if doc_index % 2 else ''">
                        <td t-esc="doc.name"/>
                        <td>
                            <span t-field="doc.entry_datetime" t-options='{"widget": "datetime"}'/>
                        </td>
                        <td>
                            <span t-att-class="'el-dir-in' if doc.direction == 'in' else 'el-dir-out'"
                                  t-esc="doc.get_report_direction_label()"/>
                        </td>
                        <td t-esc="doc.business_id.name or '—'"/>
                        <td t-esc="doc.book_id.name or '—'"/>
                        <td t-esc="doc.entry_type_id.name or '—'"/>
                        <td t-esc="doc.partner_id.name or '—'"/>
                        <td t-esc="doc.get_payment_method_labels() or '—'"/>
                        <td class="el-num" t-esc="doc.format_report_amount(doc.total_amount)"/>
                        <td class="el-num" t-esc="doc.format_report_amount(doc.paid)"/>
                        <td class="el-num" t-esc="doc.format_report_amount(doc.due)"/>
                        <td t-esc="doc.get_report_payment_status_label()"/>
                    </tr>
                </tbody>
            </table>

            <div class="el-totals-wrap">
                <table class="el-totals">
                    <t t-foreach="currency_totals" t-as="bucket">
                        <tr>
                            <td class="el-k">
                                Subtotal (<span t-esc="bucket.get('count')"/> entries
                                <t t-if="bucket.get('currency')">
                                    · <span t-esc="bucket['currency'].name"/>
                                </t>)
                            </td>
                            <td class="el-v" t-esc="bucket.get('total_label')"/>
                        </tr>
                        <tr>
                            <td class="el-k">Settled</td>
                            <td class="el-v" t-esc="bucket.get('paid_label')"/>
                        </tr>
                        <tr class="el-grand">
                            <td>Outstanding</td>
                            <td style="text-align:right;" t-esc="bucket.get('due_label')"/>
                        </tr>
                    </t>
                </table>
            </div>

            <div class="el-foot">
                Page <span class="page"/> of <span class="topage"/>
                · <span t-esc="powered_by_label"/>
            </div>
        </div>
    </template>
</odoo>
