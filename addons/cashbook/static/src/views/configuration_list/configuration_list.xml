<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="cashbook.ConfigurationList">
        <div class="o_action o_cashbook_card_list o_cashbook_configuration">
            <Layout display="display">
                <t t-set-slot="layout-buttons">
                    <div class="o_cp_buttons d-flex gap-2">
                        <t t-if="showEntryTypes and !showPaymentMethods and !showReportTemplates">
                            <button type="button" class="btn btn-primary" t-on-click="createEntryType">
                                <i class="fa fa-plus me-1"/> New Entry Type
                            </button>
                            <button type="button"
                                    class="btn btn-outline-danger"
                                    t-if="state.viewMode === 'list'"
                                    t-att-disabled="!sectionSelectedCount('entry_types')"
                                    t-on-click="() => this.deleteSectionSelected('entry_types')">
                                <i class="fa fa-trash me-1"/> Delete
                                <t t-if="sectionSelectedCount('entry_types')">
                                    (<t t-esc="sectionSelectedCount('entry_types')"/>)
                                </t>
                            </button>
                            <button type="button" class="btn btn-secondary" t-on-click="openClassicEntryTypes">
                                Classic View
                            </button>
                        </t>
                        <t t-elif="showPaymentMethods and !showEntryTypes and !showReportTemplates">
                            <button type="button" class="btn btn-primary" t-on-click="createPaymentMethod">
                                <i class="fa fa-plus me-1"/> New Payment Method
                            </button>
                            <button type="button"
                                    class="btn btn-outline-danger"
                                    t-if="state.viewMode === 'list'"
                                    t-att-disabled="!sectionSelectedCount('payment_methods')"
                                    t-on-click="() => this.deleteSectionSelected('payment_methods')">
                                <i class="fa fa-trash me-1"/> Delete
                                <t t-if="sectionSelectedCount('payment_methods')">
                                    (<t t-esc="sectionSelectedCount('payment_methods')"/>)
                                </t>
                            </button>
                            <button type="button" class="btn btn-secondary" t-on-click="openClassicPaymentMethods">
                                Classic View
                            </button>
                        </t>
                        <t t-elif="showReportTemplates and !showEntryTypes and !showPaymentMethods">
                            <button type="button" class="btn btn-primary" t-on-click="createReportTemplate">
                                <i class="fa fa-plus me-1"/> New Report Template
                            </button>
                            <button type="button"
                                    class="btn btn-outline-danger"
                                    t-if="state.viewMode === 'list'"
                                    t-att-disabled="!sectionSelectedCount('report_templates')"
                                    t-on-click="() => this.deleteSectionSelected('report_templates')">
                                <i class="fa fa-trash me-1"/> Delete
                                <t t-if="sectionSelectedCount('report_templates')">
                                    (<t t-esc="sectionSelectedCount('report_templates')"/>)
                                </t>
                            </button>
                            <button type="button" class="btn btn-secondary" t-on-click="openClassicReportTemplates">
                                Classic View
                            </button>
                        </t>
                    </div>
                </t>

                <div class="cb-card-page">
                    <div class="cb-card-toolbar">
                        <div class="cb-card-search">
                            <label class="cb-card-filter-label">Search</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="fa fa-search"/></span>
                                <input type="text" class="form-control" placeholder="Name or description..."
                                       t-model="state.search"/>
                            </div>
                        </div>
                        <div class="cb-view-toggle-wrap">
                            <label class="cb-card-filter-label">View</label>
                            <div class="cb-view-toggle">
                                <button type="button"
                                        t-att-class="'cb-view-btn' + (state.viewMode === 'grid' ? ' active' : '')"
                                        title="Card view"
                                        t-on-click="() => this.setViewMode('grid')">
                                    <i class="fa fa-th-large"/>
                                </button>
                                <button type="button"
                                        t-att-class="'cb-view-btn' + (state.viewMode === 'list' ? ' active' : '')"
                                        title="List view"
                                        t-on-click="() => this.setViewMode('list')">
                                    <i class="fa fa-list"/>
                                </button>
                            </div>
                        </div>
                    </div>

                    <t t-if="state.loading">
                        <div class="cb-empty-state">
                            <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                            <p class="mt-2 text-muted">Loading configuration...</p>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-if="showEntryTypes">
                            <div class="cb-config-section">
                                <div class="cb-config-section-head">
                                    <div>
                                        <h2 class="cb-config-title">Entry Types</h2>
                                        <p class="cb-config-subtitle">Classify cashbook transactions</p>
                                    </div>
                                    <div class="d-flex gap-2" t-if="showPaymentMethods or showReportTemplates">
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                t-on-click="createEntryType">
                                            <i class="fa fa-plus me-1"/> New
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                t-if="state.viewMode === 'list'"
                                                t-att-disabled="!sectionSelectedCount('entry_types')"
                                                t-on-click="() => this.deleteSectionSelected('entry_types')">
                                            <i class="fa fa-trash me-1"/> Delete
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                t-on-click="openClassicEntryTypes">
                                            Classic
                                        </button>
                                    </div>
                                </div>

                                <t t-if="state.viewMode === 'list' and filteredEntryTypes.length">
                                    <div class="cb-entity-table-card card">
                                        <div class="table-responsive">
                                            <table class="table table-hover cb-entity-table mb-0">
                                                <thead>
                                                    <tr>
                                                        <th class="cb-col-select">
                                                            <input type="checkbox"
                                                                   class="form-check-input"
                                                                   t-att-checked="allSectionSelected('entry_types')"
                                                                   t-on-click="(ev) => this.toggleSectionSelectAll('entry_types', ev)"/>
                                                        </th>
                                                        <th>Name</th>
                                                        <th>Description</th>
                                                        <th class="text-end">Entries</th>
                                                        <th class="text-end">Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="filteredEntryTypes" t-as="entryType" t-key="entryType.id">
                                                        <t t-set="stats" t-value="entryTypeStats(entryType)"/>
                                                        <tr t-att-class="'cb-entity-row-clickable' + (isSectionSelected('entry_types', entryType.id) ? ' cb-row-selected' : '')"
                                                            t-on-click="() => this.openEntryType(entryType)">
                                                            <td class="cb-col-select" t-on-click.stop="">
                                                                <input type="checkbox"
                                                                       class="form-check-input"
                                                                       t-att-checked="isSectionSelected('entry_types', entryType.id)"
                                                                       t-on-click="(ev) => this.toggleSectionRecord('entry_types', entryType.id, ev)"/>
                                                            </td>
                                                            <td class="fw-semibold" t-esc="entryType.name"/>
                                                            <td t-esc="entryType.description || '—'"/>
                                                            <td class="text-end" t-esc="stats.count"/>
                                                            <td class="text-end" t-esc="formatMoney(stats.total, stats.currencyId)"/>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </t>
                                <t t-elif="!filteredEntryTypes.length">
                                    <div class="cb-empty-state cb-empty-state-compact">
                                        <p class="text-muted mb-2">No entry types found.</p>
                                        <button type="button" class="btn btn-sm btn-primary" t-on-click="createEntryType">
                                            <i class="fa fa-plus me-1"/> New Entry Type
                                        </button>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="cb-card-grid">
                                        <t t-foreach="filteredEntryTypes" t-as="entryType" t-key="entryType.id">
                                            <div class="cb-entity-card cb-config-card"
                                                 t-on-click="() => this.openEntryType(entryType)">
                                                <div class="cb-entity-card-head">
                                                    <div class="cb-entity-icon cb-entity-icon-entry-type">
                                                        <i class="fa fa-tag"/>
                                                    </div>
                                                    <div class="flex-grow-1 min-w-0">
                                                        <h3 class="cb-entity-title text-truncate" t-esc="entryType.name"/>
                                                    </div>
                                                </div>
                                                <t t-if="entryType.description">
                                                    <p class="cb-entity-desc" t-esc="entryType.description"/>
                                                </t>
                                                <t t-set="stats" t-value="entryTypeStats(entryType)"/>
                                                <div class="cb-entity-stats cb-entity-stats-2">
                                                    <div class="cb-entity-stat">
                                                        <span class="cb-entity-stat-label">Entries</span>
                                                        <span class="cb-entity-stat-value" t-esc="stats.count"/>
                                                    </div>
                                                    <div class="cb-entity-stat">
                                                        <span class="cb-entity-stat-label">Total</span>
                                                        <span class="cb-entity-stat-value"
                                                              t-esc="formatMoney(stats.total, stats.currencyId)"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <t t-if="showPaymentMethods">
                            <div class="cb-config-section">
                                <div class="cb-config-section-head">
                                    <div>
                                        <h2 class="cb-config-title">Payment Methods</h2>
                                        <p class="cb-config-subtitle">Cash, bank, mobile wallet, and more</p>
                                    </div>
                                    <div class="d-flex gap-2" t-if="showEntryTypes or showReportTemplates">
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                t-on-click="createPaymentMethod">
                                            <i class="fa fa-plus me-1"/> New
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                t-if="state.viewMode === 'list'"
                                                t-att-disabled="!sectionSelectedCount('payment_methods')"
                                                t-on-click="() => this.deleteSectionSelected('payment_methods')">
                                            <i class="fa fa-trash me-1"/> Delete
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                t-on-click="openClassicPaymentMethods">
                                            Classic
                                        </button>
                                    </div>
                                </div>

                                <t t-if="state.viewMode === 'list' and filteredPaymentMethods.length">
                                    <div class="cb-entity-table-card card">
                                        <div class="table-responsive">
                                            <table class="table table-hover cb-entity-table mb-0">
                                                <thead>
                                                    <tr>
                                                        <th class="cb-col-select">
                                                            <input type="checkbox"
                                                                   class="form-check-input"
                                                                   t-att-checked="allSectionSelected('payment_methods')"
                                                                   t-on-click="(ev) => this.toggleSectionSelectAll('payment_methods', ev)"/>
                                                        </th>
                                                        <th>Name</th>
                                                        <th>Description</th>
                                                        <th class="text-end">Payments</th>
                                                        <th class="text-end">Amount</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="filteredPaymentMethods" t-as="paymentMethod" t-key="paymentMethod.id">
                                                        <t t-set="stats" t-value="paymentMethodStats(paymentMethod)"/>
                                                        <tr t-att-class="'cb-entity-row-clickable' + (isSectionSelected('payment_methods', paymentMethod.id) ? ' cb-row-selected' : '')"
                                                            t-on-click="() => this.openPaymentMethod(paymentMethod)">
                                                            <td class="cb-col-select" t-on-click.stop="">
                                                                <input type="checkbox"
                                                                       class="form-check-input"
                                                                       t-att-checked="isSectionSelected('payment_methods', paymentMethod.id)"
                                                                       t-on-click="(ev) => this.toggleSectionRecord('payment_methods', paymentMethod.id, ev)"/>
                                                            </td>
                                                            <td class="fw-semibold" t-esc="paymentMethod.name"/>
                                                            <td t-esc="paymentMethod.description || '—'"/>
                                                            <td class="text-end" t-esc="stats.count"/>
                                                            <td class="text-end cb-stat-paid" t-esc="formatMoney(stats.total)"/>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </t>
                                <t t-elif="!filteredPaymentMethods.length">
                                    <div class="cb-empty-state cb-empty-state-compact">
                                        <p class="text-muted mb-2">No payment methods found.</p>
                                        <button type="button" class="btn btn-sm btn-primary"
                                                t-on-click="createPaymentMethod">
                                            <i class="fa fa-plus me-1"/> New Payment Method
                                        </button>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="cb-card-grid">
                                        <t t-foreach="filteredPaymentMethods" t-as="paymentMethod" t-key="paymentMethod.id">
                                            <div class="cb-entity-card cb-config-card"
                                                 t-on-click="() => this.openPaymentMethod(paymentMethod)">
                                                <div class="cb-entity-card-head">
                                                    <div class="cb-entity-icon cb-entity-icon-payment">
                                                        <i class="fa fa-credit-card"/>
                                                    </div>
                                                    <div class="flex-grow-1 min-w-0">
                                                        <h3 class="cb-entity-title text-truncate" t-esc="paymentMethod.name"/>
                                                    </div>
                                                </div>
                                                <t t-if="paymentMethod.description">
                                                    <p class="cb-entity-desc" t-esc="paymentMethod.description"/>
                                                </t>
                                                <t t-set="stats" t-value="paymentMethodStats(paymentMethod)"/>
                                                <div class="cb-entity-stats cb-entity-stats-2">
                                                    <div class="cb-entity-stat">
                                                        <span class="cb-entity-stat-label">Payments</span>
                                                        <span class="cb-entity-stat-value" t-esc="stats.count"/>
                                                    </div>
                                                    <div class="cb-entity-stat">
                                                        <span class="cb-entity-stat-label">Amount</span>
                                                        <span class="cb-entity-stat-value cb-stat-paid"
                                                              t-esc="formatMoney(stats.total)"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <t t-if="showReportTemplates">
                            <div class="cb-config-section">
                                <div class="cb-config-section-head">
                                    <div>
                                        <h2 class="cb-config-title">Report Templates</h2>
                                        <p class="cb-config-subtitle">Customize invoice layout, fields, and appearance</p>
                                    </div>
                                    <div class="d-flex gap-2" t-if="showEntryTypes or showPaymentMethods">
                                        <button type="button" class="btn btn-sm btn-outline-primary"
                                                t-on-click="createReportTemplate">
                                            <i class="fa fa-plus me-1"/> New
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger"
                                                t-if="state.viewMode === 'list'"
                                                t-att-disabled="!sectionSelectedCount('report_templates')"
                                                t-on-click="() => this.deleteSectionSelected('report_templates')">
                                            <i class="fa fa-trash me-1"/> Delete
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                                t-on-click="openClassicReportTemplates">
                                            Classic
                                        </button>
                                    </div>
                                </div>

                                <t t-if="state.viewMode === 'list' and filteredReportTemplates.length">
                                    <div class="cb-entity-table-card card">
                                        <div class="table-responsive">
                                            <table class="table table-hover cb-entity-table mb-0">
                                                <thead>
                                                    <tr>
                                                        <th class="cb-col-select">
                                                            <input type="checkbox"
                                                                   class="form-check-input"
                                                                   t-att-checked="allSectionSelected('report_templates')"
                                                                   t-on-click="(ev) => this.toggleSectionSelectAll('report_templates', ev)"/>
                                                        </th>
                                                        <th>Name</th>
                                                        <th>Layout</th>
                                                        <th>Page</th>
                                                        <th>Default</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <t t-foreach="filteredReportTemplates" t-as="template" t-key="template.id">
                                                        <tr t-att-class="'cb-entity-row-clickable' + (isSectionSelected('report_templates', template.id) ? ' cb-row-selected' : '')"
                                                            t-on-click="() => this.openReportTemplate(template)">
                                                            <td class="cb-col-select" t-on-click.stop="">
                                                                <input type="checkbox"
                                                                       class="form-check-input"
                                                                       t-att-checked="isSectionSelected('report_templates', template.id)"
                                                                       t-on-click="(ev) => this.toggleSectionRecord('report_templates', template.id, ev)"/>
                                                            </td>
                                                            <td class="fw-semibold" t-esc="template.name"/>
                                                            <td t-esc="layoutLabel(template.layout)"/>
                                                            <td class="text-uppercase" t-esc="template.page_size"/>
                                                            <td>
                                                                <t t-if="template.is_default">
                                                                    <span class="badge text-bg-primary">Default</span>
                                                                </t>
                                                                <t t-else="">—</t>
                                                            </td>
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </t>
                                <t t-elif="!filteredReportTemplates.length">
                                    <div class="cb-empty-state cb-empty-state-compact">
                                        <p class="text-muted mb-2">No report templates found.</p>
                                        <button type="button" class="btn btn-sm btn-primary"
                                                t-on-click="createReportTemplate">
                                            <i class="fa fa-plus me-1"/> New Report Template
                                        </button>
                                    </div>
                                </t>
                                <t t-else="">
                                    <div class="cb-card-grid">
                                        <t t-foreach="filteredReportTemplates" t-as="template" t-key="template.id">
                                            <div class="cb-entity-card cb-config-card"
                                                 t-on-click="() => this.openReportTemplate(template)">
                                                <div class="cb-entity-card-head">
                                                    <div class="cb-entity-icon cb-entity-icon-report">
                                                        <i class="fa fa-file-text-o"/>
                                                    </div>
                                                    <div class="flex-grow-1 min-w-0">
                                                        <h3 class="cb-entity-title text-truncate" t-esc="template.name"/>
                                                        <div class="cb-entity-subtitle text-truncate"
                                                             t-esc="layoutLabel(template.layout)"/>
                                                    </div>
                                                    <t t-if="template.is_default">
                                                        <span class="badge text-bg-primary">Default</span>
                                                    </t>
                                                </div>
                                                <div class="cb-entity-stats cb-entity-stats-2">
                                                    <div class="cb-entity-stat">
                                                        <span class="cb-entity-stat-label">Layout</span>
                                                        <span class="cb-entity-stat-value" t-esc="layoutLabel(template.layout)"/>
                                                    </div>
                                                    <div class="cb-entity-stat">
                                                        <span class="cb-entity-stat-label">Page</span>
                                                        <span class="cb-entity-stat-value text-uppercase" t-esc="template.page_size"/>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </t>
                </div>
            </Layout>
        </div>
    </t>

</templates>
