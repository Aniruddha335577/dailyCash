<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cashbook_payment_method_list" model="ir.ui.view">
        <field name="name">cashbook.payment.method.list</field>
        <field name="model">cashbook.payment.method</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_cashbook_payment_method_form" model="ir.ui.view">
        <field name="name">cashbook.payment.method.form</field>
        <field name="model">cashbook.payment.method</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="active" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cashbook_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">cashbook.payment.method</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
