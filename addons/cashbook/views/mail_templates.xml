<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Password reset (web "Reset Password") -->
    <template id="cashbook_reset_password_email" inherit_id="auth_signup.reset_password_email">
        <xpath expr="//tr[td/table/tr/td/a[contains(@href, 'odoo.com')]]" position="replace"/>
        <xpath expr="//t[@t-if=&quot;user.signature&quot;]" position="replace">
            <br/>HishabBro
        </xpath>
    </template>

    <!-- Standard notification emails -->
    <template id="cashbook_mail_notification_layout" inherit_id="mail.mail_notification_layout">
        <xpath expr="//div[contains(., 'Powered by') and .//a[contains(@href, 'odoo.com')]]" position="replace"/>
    </template>

    <template id="cashbook_mail_notification_light" inherit_id="mail.mail_notification_light">
        <xpath expr="//tr[td[contains(normalize-space(.), 'Powered by')]]" position="replace"/>
    </template>
</odoo>
