<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Password reset (web "Reset Password") -->
    <template id="cashbook_reset_password_email" inherit_id="auth_signup.reset_password_email">
        <xpath expr="//tr[td/table/tr/td/a[contains(@href, 'odoo.com')]]" position="replace"/>
        <xpath expr="//t[@t-if=&quot;user.signature&quot;]" position="replace">
            <br/>DailyCash
        </xpath>
    </template>
</odoo>
