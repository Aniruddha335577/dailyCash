<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cashbook_entry" model="ir.actions.report">
        <field name="name">Invoice</field>
        <field name="model">cashbook.entry</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cashbook.report_entry</field>
        <field name="report_file">cashbook.report_entry</field>
        <field name="print_report_name">'Cashbook-%s' % (object.name.replace('/', '-'))</field>
        <field name="binding_model_id" ref="model_cashbook_entry"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_entry_styles">
        <style type="text/css">
            @page {
                size: <t t-esc="template.page_size.upper()"/>;
                margin-top: <t t-esc="template.margin_top"/>mm;
                margin-bottom: <t t-esc="template.margin_bottom + 8"/>mm;
                margin-left: <t t-esc="template.margin_left"/>mm;
                margin-right: <t t-esc="template.margin_right"/>mm;
            }
            .px-report {
                color: #26313F;
                font-family: Helvetica, Arial, sans-serif;
                font-size: 11px;
                line-height: 1.45;
            }
            .px-page {
                background: #fff;
            }
            .px-header {
                width: 100%;
                border-collapse: collapse;
            }
            .px-header td {
                padding: 28px 36px 0;
                vertical-align: top;
            }
            .px-header-brand { width: 55%; }
            .px-header-banner-cell { width: 45%; text-align: right; vertical-align: bottom !important; padding-bottom: 0 !important; }
            .px-brand-inner { border-collapse: collapse; }
            .px-brand-inner td { padding: 0; vertical-align: middle; }
            .px-logo-cell { width: 58px; padding-right: 12px !important; }
            .px-logo {
                width: 52px;
                height: 52px;
                background: #F5A623;
                border-radius: 12px;
                text-align: center;
                vertical-align: middle;
                color: #fff;
                font-weight: 800;
                font-size: 22px;
                line-height: 52px;
            }
            .px-logo img {
                max-width: 40px;
                max-height: 40px;
                vertical-align: middle;
            }
            .px-brand-name {
                font-weight: 800;
                font-size: 20px;
                color: <t t-esc="template.primary_color"/>;
                line-height: 1.1;
            }
            .px-brand-tag {
                font-size: 11px;
                color: #6B7684;
                margin-top: 2px;
            }
            .px-banner-wrap {
                display: inline-block;
                position: relative;
                min-width: 220px;
            }
            .px-banner {
                background: <t t-esc="template.primary_color"/>;
                color: #fff;
                font-weight: 800;
                font-size: 28px;
                letter-spacing: 0.04em;
                padding: 16px 28px 16px 48px;
                text-align: right;
                position: relative;
                overflow: hidden;
            }
            .px-banner-skew {
                position: absolute;
                left: -18px;
                top: 0;
                bottom: 0;
                width: 56px;
                background: #F5A623;
                transform: skewX(-22deg);
            }
            .px-banner-skew2 {
                position: absolute;
                left: 28px;
                top: 0;
                bottom: 0;
                width: 22px;
                background: #F5A623;
                transform: skewX(-22deg);
                opacity: 0.55;
            }
            .px-banner-text { position: relative; z-index: 1; }
            .px-header-text {
                font-size: 10px;
                color: #6B7684;
                padding: 8px 36px 0;
            }
            .px-meta {
                width: 100%;
                border-collapse: collapse;
            }
            .px-meta td {
                padding: 24px 36px 0;
                vertical-align: top;
            }
            .px-meta-left { width: 52%; }
            .px-meta-right { width: 48%; text-align: right; }
            .px-bill-label {
                font-size: 12px;
                color: #6B7684;
                margin-bottom: 4px;
            }
            .px-bill-name {
                color: #E0951A;
                font-weight: 700;
                font-size: 15px;
            }
            .px-bill-role {
                font-size: 12px;
                color: #6B7684;
                margin: 2px 0 8px;
            }
            .px-bill-contact {
                font-size: 12px;
                color: #26313F;
                line-height: 1.6;
            }
            .px-invoice-no {
                display: inline-block;
                background: <t t-esc="template.primary_color"/>;
                color: #fff;
                font-weight: 600;
                font-size: 12px;
                padding: 7px 14px;
                letter-spacing: 0.02em;
            }
            .px-meta-rows {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
            }
            .px-meta-rows td {
                padding: 3px 0 3px 12px;
                font-size: 12px;
                text-align: right;
            }
            .px-meta-rows .px-k {
                color: #6B7684;
                padding-right: 18px;
                white-space: nowrap;
            }
            .px-meta-rows .px-v {
                font-weight: 600;
                white-space: nowrap;
            }
            .px-items {
                padding: 22px 36px 0;
            }
            .px-items-table {
                width: 100%;
                border-collapse: collapse;
            }
            .px-items-table thead { display: table-header-group; }
            .px-items-table th {
                color: #fff;
                font-weight: 600;
                font-size: 12px;
                text-align: left;
                padding: 11px 14px;
            }
            .px-items-table th.px-th-desc { background: #F5A623; }
            .px-items-table th.px-th-num {
                background: <t t-esc="template.primary_color"/>;
                text-align: center;
            }
            .px-items-table tbody tr.px-row-alt { background: #F4F5F7; }
            .px-items-table td {
                padding: 12px 14px;
                vertical-align: top;
                font-size: 12px;
                border-bottom: 1px solid #fff;
            }
            .px-items-table td.px-num {
                text-align: center;
                font-weight: 600;
            }
            .px-item-name { font-weight: 600; color: #26313F; margin-bottom: 3px; }
            .px-item-desc { color: #6B7684; font-size: 10px; line-height: 1.45; }
            .px-split {
                width: 100%;
                border-collapse: collapse;
            }
            .px-split td {
                padding: 20px 36px 0;
                vertical-align: top;
            }
            .px-split-left { width: 55%; }
            .px-split-right { width: 45%; }
            .px-payment-label {
                font-weight: 700;
                font-size: 13px;
                margin-bottom: 8px;
            }
            .px-payment-row {
                width: 100%;
                border-collapse: collapse;
            }
            .px-payment-row td {
                padding: 2px 0;
                font-size: 12px;
            }
            .px-payment-row .px-k {
                color: #6B7684;
                width: 90px;
            }
            .px-totals {
                width: 260px;
                margin-left: auto;
                border-collapse: collapse;
            }
            .px-totals td {
                padding: 6px 4px;
                font-size: 12px;
            }
            .px-totals .px-k { color: #6B7684; }
            .px-totals .px-v { text-align: right; font-weight: 600; }
            .px-grand td {
                background: #F5A623;
                color: #fff;
                font-weight: 700;
                font-size: 13px;
                padding: 10px 12px;
            }
            .px-bottom {
                width: 100%;
                border-collapse: collapse;
            }
            .px-bottom td {
                padding: 22px 36px 16px;
                vertical-align: bottom;
            }
            .px-bottom-left { width: 62%; }
            .px-bottom-right { width: 38%; text-align: center; }
            .px-terms-label {
                font-weight: 700;
                font-size: 12px;
                margin-bottom: 4px;
            }
            .px-terms-body {
                font-size: 11px;
                color: #6B7684;
                line-height: 1.55;
                white-space: pre-wrap;
            }
            .px-thanks {
                font-weight: 700;
                font-size: 13px;
                margin-top: 10px;
            }
            .px-sign-script {
                font-style: italic;
                font-size: 22px;
                color: <t t-esc="template.primary_color"/>;
                border-bottom: 1px solid #26313F;
                padding-bottom: 4px;
                margin-bottom: 4px;
            }
            .px-sign-name {
                font-weight: 700;
                font-size: 12px;
            }
            .px-sign-role {
                font-size: 10px;
                color: #6B7684;
            }
            .px-contact {
                width: 100%;
                border-collapse: collapse;
                border-top: 1px solid #E4E6EA;
            }
            .px-contact td {
                padding: 12px 36px;
                font-size: 11px;
                vertical-align: middle;
            }
            .px-contact-item { white-space: nowrap; padding-right: 24px; }
            .px-dot {
                display: inline-block;
                width: 22px;
                height: 22px;
                border-radius: 50%;
                background: <t t-esc="template.primary_color"/>;
                color: #fff;
                text-align: center;
                line-height: 22px;
                font-size: 10px;
                margin-right: 6px;
                vertical-align: middle;
            }
            .px-dot-gold { background: #F5A623; }
            .px-bottom-banner {
                height: 26px;
                background: <t t-esc="template.primary_color"/>;
                position: relative;
                overflow: hidden;
            }
            .px-bottom-banner span {
                position: absolute;
                top: 0;
                bottom: 0;
                width: 40px;
                background: #F5A623;
                transform: skewX(-22deg);
            }
            .px-powered {
                text-align: center;
                font-size: 9px;
                color: #6B7684;
                padding: 6px 0 2px;
            }
            .px-powered img {
                max-height: 12px;
                vertical-align: middle;
                margin-right: 4px;
            }
        </style>
    </template>

    <template id="report_entry_header">
        <t t-set="business" t-value="doc.get_report_business()"/>
        <table class="px-header">
            <tr>
                <td class="px-header-brand">
                    <table class="px-brand-inner">
                        <tr>
                            <td class="px-logo-cell">
                                <div class="px-logo">
                                    <t t-if="template.show_logo and business.logo">
                                        <img t-att-src="image_data_uri(business.logo)" alt="Logo"/>
                                    </t>
                                    <t t-else="">
                                        <span t-esc="business.get_report_initials()"/>
                                    </t>
                                </div>
                            </td>
                            <td>
                                <t t-if="template.show_company_name and business.name">
                                    <div class="px-brand-name" t-esc="business.name"/>
                                </t>
                                <t t-if="business.get_report_tagline()">
                                    <div class="px-brand-tag" t-esc="business.get_report_tagline()"/>
                                </t>
                            </td>
                        </tr>
                    </table>
                </td>
                <td class="px-header-banner-cell">
                    <div class="px-banner-wrap">
                        <div class="px-banner">
                            <div class="px-banner-skew"/>
                            <div class="px-banner-skew2"/>
                            <span class="px-banner-text">INVOICE</span>
                        </div>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_entry_meta">
        <table class="px-meta">
            <tr>
                <td class="px-meta-left">
                    <t t-if="template.show_partner">
                        <div class="px-bill-label">Invoice To:</div>
                        <div class="px-bill-name" t-esc="doc.partner_id.name or '—'"/>
                        <t t-if="doc.partner_id">
                            <div class="px-bill-role">
                                <t t-if="doc.partner_id.partner_type == 'customer'">Customer</t>
                                <t t-else="">Vendor</t>
                            </div>
                            <div class="px-bill-contact">
                                <t t-if="doc.partner_id.phone">
                                    P : <span t-esc="doc.partner_id.phone"/><br/>
                                </t>
                            </div>
                        </t>
                    </t>
                </td>
                <td class="px-meta-right">
                    <t t-if="template.show_invoice_number or template.show_reference">
                        <div class="px-invoice-no">
                            INVOICE NO: #<span t-esc="doc.name"/>
                        </div>
                    </t>
                    <table class="px-meta-rows">
                        <t t-if="template.show_book">
                            <tr>
                                <td class="px-k">Ledger Book</td>
                                <td class="px-v" t-esc="doc.book_id.name or '—'"/>
                            </tr>
                        </t>
                        <t t-if="template.show_date">
                            <tr>
                                <td class="px-k">Invoice Date</td>
                                <td class="px-v">
                                    <span t-field="doc.entry_datetime" t-options='{"widget": "date"}'/>
                                </td>
                            </tr>
                        </t>
                        <t t-if="template.show_entry_type">
                            <tr>
                                <td class="px-k">Entry Type</td>
                                <td class="px-v" t-esc="doc.entry_type_id.name or '—'"/>
                            </tr>
                        </t>
                        <t t-if="template.show_money_direction">
                            <tr>
                                <td class="px-k">Direction</td>
                                <td class="px-v" t-esc="doc.get_report_direction_label()"/>
                            </tr>
                        </t>
                    </table>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_entry_lines">
        <t t-if="template.show_line_items and doc.line_ids">
            <div class="px-items">
                <table class="px-items-table">
                    <thead>
                        <tr>
                            <th class="px-th-desc">Item description</th>
                            <th class="px-th-num">Quantity</th>
                            <th class="px-th-num">Unit Price</th>
                            <th class="px-th-num">Total Price</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="doc.line_ids" t-as="line" t-attf-class="#{line_index % 2 and 'px-row-alt' or ''}">
                            <td>
                                <div class="px-item-name" t-esc="line.product_name"/>
                                <t t-if="line.description">
                                    <div class="px-item-desc" t-esc="line.description"/>
                                </t>
                            </td>
                            <td class="px-num">
                                <span t-esc="line.quantity"/>
                                <t t-if="line.uom"> <span t-esc="line.uom"/></t>
                            </td>
                            <td class="px-num">
                                <span t-esc="doc.format_report_amount_value(line.product_price)"/>
                            </td>
                            <td class="px-num">
                                <span t-esc="doc.format_report_amount_value(line.total_price)"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="report_entry_amounts">
        <table class="px-split">
            <tr>
                <td class="px-split-left">
                    <t t-if="template.show_payment_method">
                        <div class="px-payment-label">Payment method</div>
                        <table class="px-payment-row">
                            <tr>
                                <td class="px-k">Method</td>
                                <td t-esc="doc.get_payment_method_labels() or '—'"/>
                            </tr>
                            <t t-if="template.show_book">
                                <tr>
                                    <td class="px-k">Book</td>
                                    <td t-esc="doc.book_id.name or '—'"/>
                                </tr>
                            </t>
                        </table>
                    </t>
                </td>
                <td class="px-split-right">
                    <t t-if="template.show_amount or template.show_paid or template.show_due">
                        <table class="px-totals">
                            <t t-if="template.show_amount and (template.show_paid or template.show_due)">
                                <tr>
                                    <td class="px-k">Sub Total</td>
                                    <td class="px-v" t-esc="doc.format_report_amount(doc.total_amount)"/>
                                </tr>
                            </t>
                            <t t-if="template.show_paid">
                                <tr>
                                    <td class="px-k">Amount Paid</td>
                                    <td class="px-v" t-esc="doc.format_report_amount(doc.paid)"/>
                                </tr>
                            </t>
                            <t t-if="template.show_due">
                                <tr class="px-grand">
                                    <td>Balance Due</td>
                                    <td style="text-align:right;" t-esc="doc.format_report_amount(doc.due)"/>
                                </tr>
                            </t>
                            <t t-if="template.show_amount and not template.show_due">
                                <tr class="px-grand">
                                    <td>Grand Total</td>
                                    <td style="text-align:right;" t-esc="doc.format_report_amount(doc.total_amount)"/>
                                </tr>
                            </t>
                        </table>
                    </t>
                </td>
            </tr>
        </table>
    </template>

    <template id="report_entry_notes">
        <t t-set="business" t-value="doc.get_report_business()"/>
        <t t-set="footer_text" t-value="doc.get_report_footer_text(template)"/>
        <t t-if="(template.show_description and doc.remarks) or footer_text or (template.show_company_name and business.name)">
            <table class="px-bottom">
                <tr>
                    <td class="px-bottom-left">
                        <t t-if="template.show_description and doc.remarks">
                            <div class="px-terms-label">Notes:</div>
                            <div class="px-terms-body" t-esc="doc.remarks"/>
                        </t>
                        <t t-if="footer_text">
                            <div class="px-terms-label">Terms &amp; Conditions:</div>
                            <div class="px-terms-body" t-esc="footer_text"/>
                        </t>
                        <div class="px-thanks">Thanks for your business!</div>
                    </td>
                    <td class="px-bottom-right">
                        <t t-if="template.show_company_name and business.name">
                            <div class="px-sign-script" t-esc="business.name"/>
                            <div class="px-sign-name" t-esc="(business.legal_name or business.name).upper()"/>
                            <t t-if="business.city">
                                <div class="px-sign-role" t-esc="business.city"/>
                            </t>
                        </t>
                    </td>
                </tr>
            </table>
        </t>
    </template>

    <template id="report_entry_footer">
        <t t-set="business" t-value="doc.get_report_business()"/>
        <table class="px-contact">
            <tr>
                <td>
                    <t t-if="template.show_footer_contact">
                        <t t-if="template.show_phone and business.phone_1">
                            <span class="px-contact-item">
                                <span class="px-dot">☎</span>
                                <span t-esc="business.phone_1"/>
                            </span>
                        </t>
                        <t t-if="template.show_website and business.website">
                            <span class="px-contact-item">
                                <span class="px-dot px-dot-gold">✉</span>
                                <span t-esc="business.website"/>
                            </span>
                        </t>
                        <t t-elif="template.show_email and business.email">
                            <span class="px-contact-item">
                                <span class="px-dot px-dot-gold">✉</span>
                                <span t-esc="business.email"/>
                            </span>
                        </t>
                        <t t-if="template.show_address and business.get_report_address_oneline()">
                            <span class="px-contact-item">
                                <span class="px-dot">⌂</span>
                                <span t-esc="business.get_report_address_oneline()"/>
                            </span>
                        </t>
                    </t>
                </td>
            </tr>
        </table>
        <div class="px-bottom-banner">
            <span style="left:44%;"/>
            <span style="left:52%; opacity:0.7;"/>
            <span style="left:60%; opacity:0.4;"/>
        </div>
        <t t-if="template.show_powered_by or template.show_page_number">
            <div class="px-powered">
                <t t-if="template.show_saas_logo and saas_logo_data_uri">
                    <img t-att-src="saas_logo_data_uri" t-att-alt="saas_product_label"/>
                </t>
                <t t-if="template.show_powered_by">
                    <span t-esc="powered_by_label"/>
                </t>
                <t t-if="template.show_page_number">
                    · Page <span class="page"/> of <span class="topage"/>
                </t>
            </div>
        </t>
    </template>

    <template id="report_entry_document">
        <t t-set="template" t-value="doc.get_effective_report_template()"/>
        <t t-if="not template">
            <div>No report template configured.</div>
        </t>
        <t t-else="">
            <div t-attf-class="px-report px-layout-#{template.layout}">
                <t t-call="cashbook.report_entry_styles"/>
                <div class="px-page">
                    <t t-if="template.header_text">
                        <div t-attf-class="px-header-text cb-align-#{template.header_alignment}" t-esc="template.header_text"/>
                    </t>

                    <t t-call="cashbook.report_entry_header"/>
                    <t t-call="cashbook.report_entry_meta"/>
                    <t t-call="cashbook.report_entry_lines"/>
                    <t t-call="cashbook.report_entry_amounts"/>
                    <t t-call="cashbook.report_entry_notes"/>
                    <t t-call="cashbook.report_entry_footer"/>
                </div>
            </div>
        </t>
    </template>

    <template id="report_entry">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <div class="page">
                    <t t-call="cashbook.report_entry_document"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
