<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="param_provisioner_master_key" model="ir.config_parameter">
        <field name="key">saas.provisioner.master_key</field>
        <field name="value">softobro-provisioner-master-change-me</field>
    </record>
    <record id="param_saas_tenant_mode" model="ir.config_parameter">
        <field name="key">saas.tenant_mode</field>
        <field name="value">True</field>
    </record>
    <record id="param_it_support_login" model="ir.config_parameter">
        <field name="key">saas.it_support_login</field>
        <field name="value">support@softobro.internal</field>
    </record>
    <record id="param_saas_public_base_domain" model="ir.config_parameter">
        <field name="key">saas.public_base_domain</field>
        <field name="value">softobro.com</field>
    </record>
    <record id="param_saas_tenant_url_suffix" model="ir.config_parameter">
        <field name="key">saas.tenant_url_suffix</field>
        <field name="value">-hishabbro</field>
    </record>
    <record id="param_saas_public_url_scheme" model="ir.config_parameter">
        <field name="key">saas.public_url_scheme</field>
        <field name="value">https</field>
    </record>
</odoo>
